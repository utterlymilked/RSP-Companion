{
  "expo": {
    "name": "RSC Companion",
    "slug": "rsc-companion",
    "scheme": "rsc",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pt.realsportmassama.companion",
      "supportsTablet": true
    },
    "android": {
      "package": "pt.realsportmassama.companion"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-web-browser", "expo-localization"]
  }
}
