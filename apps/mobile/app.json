{
  "expo": {
    "name": "SFF RSC",
    "slug": "rsc-companion",
    "scheme": "rsc",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pt.realsportmassama.companion",
      "supportsTablet": true
    },
    "android": {
      "package": "pt.realsportmassama.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O SFF RSC usa a câmara para fotografar documentos.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "icon": "./assets/icon.png",
    "primaryColor": "#0863B0",
    "runtimeVersion": "3",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
