  "privacyNotice": {
    "title": "Política de privacidade",
    "updated": "Versão de outubro de 2026.",
    "controller": {
      "title": "Responsável pelo tratamento",
      "body": "Real Sport Clube Massamá (RSC), que usa esta aplicação para gerir a atividade do clube."
    },
    "data": {
      "title": "Que dados tratamos",
      "body": "Identificação e contactos de atletas, encarregados de educação, sócios e staff; inscrições, equipas, horários, convocatórias e presenças; quotas e pagamentos; documentos (cartão de cidadão, exame médico, inscrição federativa); avaliações desportivas; e, só para o pessoal clínico de cada área, dados de saúde e lesões."
    },
    "purposes": {
      "title": "Para quê",
      "body": "Organizar treinos, jogos, transportes e instalações; cumprir obrigações federativas, de seguro e contabilísticas; acompanhar a saúde e a disponibilidade dos atletas; e comunicar com atletas e famílias. Os dados de saúde de menores só são registados com consentimento do encarregado de educação. Imagens e transporte dependem de consentimento, que pode ser retirado na aplicação."
    },
    "recipients": {
      "title": "Quem trata os dados por nós",
      "body": "Hetzner (alojamento e cópias de segurança, Alemanha, UE); Brevo (envio de emails, França, UE); Expo (envio de notificações, EUA), Apple (APNs) e Google (Firebase Cloud Messaging), que recebem só o identificador do telemóvel e um texto genérico, sem dados pessoais. Não vendemos dados nem os usamos para publicidade."
    },
    "retention": {
      "title": "Durante quanto tempo",
      "body": "Enquanto durar a ligação ao clube e o necessário para obrigações legais (por exemplo, registos contabilísticos). Prospeções de scouting: 12 meses. Registo de acessos: 3 anos. Avisos na aplicação: 12 meses. As cópias de segurança são apagadas ao fim de 30 dias."
    },
    "rights": {
      "title": "Os seus direitos",
      "body": "Pode consultar e descarregar os seus dados e os dos seus educandos, retirar consentimentos, pedir correção ou eliminação e eliminar a sua conta, tudo em Conta → Os meus dados. Pode também reclamar junto da CNPD (www.cnpd.pt)."
    },
    "contact": {
      "title": "Contacto",
      "body": "Secretaria do Real Sport Clube Massamá."
    }
  },
