  "privacyNotice": {
    "title": "Privacy notice",
    "updated": "October 2026 version.",
    "controller": {
      "title": "Controller",
      "body": "Real Sport Clube Massamá (RSC), which uses this app to run the club's activity."
    },
    "data": {
      "title": "What data we process",
      "body": "Identity and contacts of athletes, parents and guardians, members and staff; registrations, teams, schedules, call-ups and attendance; fees and payments; documents (ID card, medical exam, federation registration); sports evaluations; and, only for the clinical staff of each discipline, health and injury data."
    },
    "purposes": {
      "title": "Why",
      "body": "To organise trainings, matches, transport and facilities; to meet federation, insurance and accounting obligations; to follow athletes' health and availability; and to communicate with athletes and families. Minors' health data is only recorded with the guardian's consent. Images and transport depend on consent, which can be withdrawn in the app."
    },
    "recipients": {
      "title": "Who processes data for us",
      "body": "Hetzner (hosting and backups, Germany, EU); Brevo (email delivery, France, EU); Expo (push delivery, USA), Apple (APNs) and Google (Firebase Cloud Messaging), which receive only the phone's token and a generic text, no personal data. We do not sell data or use it for advertising."
    },
    "retention": {
      "title": "How long",
      "body": "For as long as the relationship with the club lasts and as needed for legal obligations (for example, accounting records). Scouting prospects: 12 months. Access log: 3 years. In-app notices: 12 months. Backups are deleted after 30 days."
    },
    "rights": {
      "title": "Your rights",
      "body": "You can view and download your data and your children's, withdraw consents, ask for correction or erasure and delete your account, all under Account → My data. You can also complain to the CNPD (www.cnpd.pt)."
    },
    "contact": {
      "title": "Contact",
      "body": "The office (secretaria) of Real Sport Clube Massamá."
    }
  },
