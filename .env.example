# Copy to .env for local development.
PORT=3000
# Public URL of the app on the web (links in emails, trusted origin). Must be https in production.
APP_URL=http://localhost:8081
# Signs sessions and tokens; at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
# smtp(s)://user:pass@host:port. Unset in development: emails are printed to the console.
# SMTP_URL=
# MAIL_FROM="RSC Companion <no-reply@example.pt>"
DATABASE_URL=postgres://rsc:rsc@localhost:5432/rsc
# Tests recreate this database on every run (name must end in _test).
# Defaults to DATABASE_URL with "_test" appended.
# TEST_DATABASE_URL=postgres://rsc:rsc@localhost:5432/rsc_test
# Production: directory of the app's web build (apps/mobile/dist), served at /.
# WEB_DIST_DIR=/app/web
# Universal links / App Links: serve the .well-known files (docs/OPERATIONS.md, section 8).
# APPLE_TEAM_ID=ABCDE12345
# ANDROID_CERT_SHA256=AB:CD:...
# Uploaded documents (M14). Either a local directory (development) or an S3-compatible bucket.
# Without either, uploads answer 503 and everything else works.
# STORAGE_DIR=./data/uploads
# STORAGE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# STORAGE_S3_REGION=fsn1
# STORAGE_S3_BUCKET=rsc-documents
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
