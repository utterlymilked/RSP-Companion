# Copy to .env for local development.
PORT=3000
# Public URL of the app on the web (links in emails, trusted origin). Must be https in production.
APP_URL=http://localhost:8081
# Signs sessions and tokens; at least 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-in-production
# smtp(s)://user:pass@host:port. Unset in development: emails are printed to the console.
# SMTP_URL=
# MAIL_FROM="RSP Companion <no-reply@example.pt>"
DATABASE_URL=postgres://rsp:rsp@localhost:5432/rsp
# Tests recreate this database on every run (name must end in _test).
# Defaults to DATABASE_URL with "_test" appended.
# TEST_DATABASE_URL=postgres://rsp:rsp@localhost:5432/rsp_test
