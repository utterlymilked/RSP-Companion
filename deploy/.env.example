# Every setting deploy/compose.yml reads. On the server /opt/rsc/.env is assembled by
# deploy/ci.sh from GitHub variables and secrets (github.env) and the server's own
# local.env (generated secrets), see docs/OPERATIONS.md. This file documents the keys and
# serves as a template for running the stack by hand. Never commit a filled copy.

# Domain whose DNS A record points at this server; Caddy fetches its HTTPS certificate.
# Without a domain yet, use the server's sslip.io name, e.g. 203-0-113-7.sslip.io.
APP_DOMAIN=app.example.pt
APP_URL=https://app.example.pt
# Image to run (pushed by .github/workflows/image.yml). Pin a commit tag (sha-xxxxxxx) to roll back.
APP_IMAGE=ghcr.io/utterlymilked/rsc-companion:main

# Signs sessions and tokens; at least 32 characters. Changing it signs everybody out.
BETTER_AUTH_SECRET=
# Outgoing email, e.g. Brevo: smtp://LOGIN:SMTP_KEY@smtp-relay.brevo.com:587
SMTP_URL=
MAIL_FROM="RSC Companion <no-reply@example.pt>"

# Database (stays inside the server; letters and digits only for the password).
POSTGRES_USER=rsc
POSTGRES_PASSWORD=
POSTGRES_DB=rsc

# Nightly backups (deploy/backup.sh) to S3-compatible storage, e.g. Hetzner Object Storage.
BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30

# Universal links / App Links (M4b): set once the store accounts exist.
# APPLE_TEAM_ID=ABCDE12345
# ANDROID_CERT_SHA256=AB:CD:...
