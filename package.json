{
  "name": "rsc-companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @rsc/server db:generate",
    "db:migrate": "pnpm --filter @rsc/server db:migrate",
    "db:seed": "pnpm --filter @rsc/server db:seed",
    "people:import": "pnpm --filter @rsc/server people:import",
    "bookings:import": "pnpm --filter @rsc/server bookings:import",
    "events:import": "pnpm --filter @rsc/server events:import",
    "admin:create": "pnpm --filter @rsc/server admin:create"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
